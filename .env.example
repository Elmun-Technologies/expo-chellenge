# .env fayl ko'rinishi (bot ishga tushirishdan oldin to'ldiring)

# BotFather'dan olingan token — MAJBURIY
BOT_TOKEN=123456:ABC...

# Ma'lumotlar bazasi (lokalda sqlite, fly.io da postgres avtomatik ulanadi)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Superadminlar Telegram ID lari (vergul bilan)
SUPERADMIN_IDS=111111111

# Moderatsiya guruhining ID si (manfiy son, masalan -100xxxxxxxxxx)
REVIEW_GROUP_ID=-1000000000000

# G'oliblar e'lon qilinadigan kanal/guruh ID si (ixtiyoriy)
ANNOUNCE_CHAT_ID=-1000000000000

# Health-check HTTP porti
WEB_PORT=8080
